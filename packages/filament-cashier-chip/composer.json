{
    "name": "aiarmada/filament-cashier-chip",
    "description": "Filament admin panel for Cashier CHIP subscription billing management",
    "license": "MIT",
    "homepage": "https://github.com/aiarmada/commerce",
    "support": {
        "issues": "https://github.com/aiarmada/commerce/issues",
        "source": "https://github.com/aiarmada/commerce"
    },
    "require": {
        "aiarmada/commerce-support": "self.version",
        "aiarmada/cashier-chip": "self.version",
        "filament/filament": "^5.11.1",
        "php": "^8.5"
    },
    "suggest": {
        "aiarmada/chip": "Optional integration",
        "aiarmada/filament-chip": "Shared resources for Chip purchases",
        "aiarmada/filament-permissions": "Role-based access to billing features"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\FilamentCashierChip\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\FilamentCashierChip\\FilamentCashierChipServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
