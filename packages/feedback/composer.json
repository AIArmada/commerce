{
    "name": "aiarmada/feedback",
    "description": "Core feedback, survey, response, invitation, analytics, and testimonial package for AI Armada applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "feedback",
        "surveys",
        "nps",
        "csat",
        "testimonials",
        "analytics"
    ],
    "authors": [
        {
            "name": "AIArmada",
            "email": "dev@aiarmada.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "aiarmada/contacting": "self.version",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "suggest": {
        "aiarmada/filament-feedback": "Admin panel adapter for managing feedback forms and responses.",
        "aiarmada/events": "Attach feedback forms to events, occurrences, sessions, speakers, and venues.",
        "aiarmada/certificates": "React to feedback submission before issuing certificates.",
        "aiarmada/engagement": "Publish approved testimonials and public review summaries."
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Feedback\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Feedback\\FeedbackServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
