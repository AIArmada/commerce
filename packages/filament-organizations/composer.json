{
  "name": "aiarmada/filament-organizations",
  "description": "Filament v5 administration for reusable AIArmada organizations tenancy.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "filament",
    "organizations",
    "tenancy"
  ],
  "authors": [
    {
      "name": "AIArmada",
      "email": "dev@aiarmada.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "aiarmada/organizations": "self.version",
    "aiarmada/membership": "self.version",
    "filament/filament": "^5.6.7",
    "spatie/laravel-package-tools": "^1.16"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentOrganizations\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentOrganizations\\FilamentOrganizationsServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
