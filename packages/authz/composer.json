{
  "name": "aiarmada/authz",
  "description": "Generic Spatie Permission wrapper with scoped authorization and impersonation for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "aiarmada/commerce-support": "self.version",
    "spatie/laravel-package-tools": "^1.93.3",
    "spatie/laravel-permission": "^8.3.2"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\Authz\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\Authz\\AuthzServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "suggest": {
    "aiarmada/filament-authz": "Optional integration"
  },
  "require-dev": {
    "nikic/php-parser": "^5"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
