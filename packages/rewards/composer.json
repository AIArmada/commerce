{
    "name": "aiarmada/rewards",
    "description": "Configurable reward programs (recognition, points, badges, cash, benefits) for Laravel applications",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AIArmada/rewards",
    "support": {
        "issues": "https://github.com/AIArmada/rewards/issues",
        "source": "https://github.com/AIArmada/rewards"
    },
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "lorisleiva/laravel-actions": "^2.13.0",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "suggest": {
        "aiarmada/affiliates": "Enables the Affiliates-backed cash payout executor adapter",
        "aiarmada/vouchers": "Enables coupon-backed benefit fulfillment"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Rewards\\": "src/",
            "AIArmada\\Rewards\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Rewards\\RewardsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
