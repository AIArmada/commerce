{
    "name": "aiarmada/referrals",
    "description": "Member-get-member referral programs for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "lorisleiva/laravel-actions": "^2.13.0",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "suggest": {
        "aiarmada/affiliates": "Provides the affiliate cash fulfilment rail.",
        "aiarmada/rewards": "Provides the points fulfilment rail.",
        "aiarmada/vouchers": "Provides the voucher fulfilment rail."
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Referrals\\": "src/",
            "AIArmada\\Referrals\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Referrals\\ReferralsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
