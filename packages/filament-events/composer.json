{
  "name": "aiarmada/filament-events",
  "description": "Filament admin for aiarmada/events: manage events, occurrences, registrations, attendance, venues.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "aiarmada/commerce-support": "self.version",
    "aiarmada/events": "self.version",
    "filament/filament": "^5.11.1",
    "filament/spatie-laravel-media-library-plugin": "^5.11.1"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentEvents\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentEvents\\FilamentEventsServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "suggest": {
    "aiarmada/customers": "Optional integration",
    "aiarmada/ticketing": "Optional integration"
  },
  "require-dev": {
    "nikic/php-parser": "^5"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
