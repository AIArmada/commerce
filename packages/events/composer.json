{
  "name": "aiarmada/events",
  "description": "Generic reusable Laravel events package with scheduling, locations, registrations, ticketing, attendance, and Filament administration",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "events",
    "scheduling",
    "registrations",
    "attendance",
    "ticketing",
    "venues"
  ],
  "authors": [
    {
      "name": "AIArmada",
      "email": "dev@aiarmada.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "aiarmada/commerce-support": "self.version",
    "aiarmada/addressing": "self.version",
    "aiarmada/communications": "self.version",
    "aiarmada/contacting": "self.version",
    "aiarmada/inventory": "self.version",
    "aiarmada/seating": "self.version",
    "aiarmada/ticketing": "self.version",
    "spatie/laravel-medialibrary": "^11.23.11",
    "spatie/laravel-model-states": "^2.14.3",
    "spatie/laravel-package-tools": "^1.93.3"
  },
  "suggest": {
    "aiarmada/authz": "Optional integration for scoped management assignments",
    "aiarmada/cart": "Optional integration",
    "aiarmada/checkout": "Enables cart and checkout orchestration for ticket purchasing.",
    "aiarmada/customers": "Enables customer-backed registrants and participants.",
    "aiarmada/engagement": "Optional integration",
    "aiarmada/filament-authz": "Optional integration",
    "aiarmada/orders": "Enables order-item fulfillment and event order completion sync.",
    "aiarmada/products": "Enables product/variant relationships for tickets and merchandise."
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\Events\\": "src/",
      "AIArmada\\Events\\Database\\Factories\\": "database/factories"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\Events\\EventsServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:writes": "cd ../.. && php vendor/bin/phpstan analyse -c packages/events/tools/package-phpstan.neon --autoload-file=packages/events/tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
