{
    "name": "aiarmada/filament-docs",
    "description": "A comprehensive Filament admin interface for managing documents created by the AIArmada Docs package",
    "license": "MIT",
    "homepage": "https://github.com/aiarmada/commerce",
    "support": {
        "issues": "https://github.com/aiarmada/commerce/issues",
        "source": "https://github.com/aiarmada/commerce"
    },
    "require": {
        "aiarmada/commerce-support": "self.version",
        "aiarmada/docs": "self.version",
        "filament/filament": "^5.11.1",
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\FilamentDocs\\": "src/",
            "AIArmada\\FilamentDocs\\Database\\Factories\\": "database/factories/",
            "AIArmada\\FilamentDocs\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\FilamentDocs\\FilamentDocsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
