{
    "name": "aiarmada/filament-referrals",
    "description": "A Filament v5 adapter for AIArmada referral programs, invites, and rewards",
    "license": "MIT",
    "require": {
        "aiarmada/commerce-support": "self.version",
        "aiarmada/referrals": "self.version",
        "filament/filament": "^5.11.1",
        "php": "^8.5",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\FilamentReferrals\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\FilamentReferrals\\FilamentReferralsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
