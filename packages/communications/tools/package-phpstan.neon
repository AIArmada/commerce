parameters:
    customRulesetUsed: true
    configDirectories:
        - %currentWorkingDirectory%/config
    paths:
        - ../src
        - ../config
    tmpDir: ../../../build/phpstan-arch-communications

services:
    -
        class: PackageArchitecture\StaticAnalysis\PackageOwnedWriteRule
        arguments:
            projectRoot: null
        tags:
            - phpstan.rules.rule
