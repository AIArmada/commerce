{
    "name": "aiarmada/filament-persons",
    "description": "Filament admin for aiarmada/persons: manage persons, titles, credentials, affiliations.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aiarmada/commerce-support": "self.version",
        "aiarmada/persons": "self.version",
        "filament/filament": "^5.8.1"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\FilamentPersons\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\FilamentPersons\\FilamentPersonsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
