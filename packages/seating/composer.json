{
    "name": "aiarmada/seating",
    "description": "Venue seat layout, seat allocation, and seat-map rendering primitive.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "seating",
        "venues",
        "seats",
        "allocations"
    ],
    "authors": [
        {
            "name": "AIArmada",
            "email": "dev@aiarmada.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "spatie/laravel-data": "^4.23.1",
        "spatie/laravel-package-tools": "^1.93.3",
        "livewire/livewire": "^4.4.8"
    },
    "suggest": {
        "aiarmada/events": "Enables event-scoped seat maps.",
        "aiarmada/ticketing": "Enables seat allocation for passes."
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Seating\\": "src/",
            "AIArmada\\Seating\\Database\\Factories\\": "database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Seating\\SeatingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "cd ../.. && php vendor/bin/phpstan analyse -c packages/seating/tools/package-phpstan.neon --autoload-file=packages/seating/tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
