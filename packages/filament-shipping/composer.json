{
  "name": "aiarmada/filament-shipping",
  "description": "Filament admin panel integration for aiarmada/shipping",
  "license": "MIT",
  "homepage": "https://github.com/aiarmada/commerce",
  "support": {
    "issues": "https://github.com/aiarmada/commerce/issues",
    "source": "https://github.com/aiarmada/commerce"
  },
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/shipping": "self.version",
    "filament/filament": "^5.11.1",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentShipping\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentShipping\\FilamentShippingServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "suggest": {
    "aiarmada/filament-orders": "Optional integration",
    "aiarmada/orders": "Optional integration"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
