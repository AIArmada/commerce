{
    "name": "aiarmada/contacting",
    "description": "Generic reusable contact methods and social profiles for any entity in Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "contact",
        "social",
        "profiles",
        "phone",
        "email",
        "whatsapp"
    ],
    "authors": [
        {
            "name": "AIArmada",
            "email": "dev@aiarmada.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "propaganistas/laravel-phone": "^6.1.0",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "suggest": {
        "aiarmada/filament-contacting": "Filament admin UI for contact methods and social profiles."
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Contacting\\": "src/",
            "AIArmada\\Contacting\\Database\\Factories\\": "database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Contacting\\ContactingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
