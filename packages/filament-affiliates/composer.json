{
  "name": "aiarmada/filament-affiliates",
  "description": "Filament admin plugin for managing AIArmada affiliate programs, attributions, and commissions.",
  "license": "MIT",
  "homepage": "https://github.com/aiarmada/commerce",
  "support": {
    "issues": "https://github.com/aiarmada/commerce/issues",
    "source": "https://github.com/aiarmada/commerce"
  },
  "require": {
    "aiarmada/affiliates": "self.version",
    "aiarmada/authz": "self.version",
    "aiarmada/commerce-support": "self.version",
    "filament/filament": "^5.11.1",
    "filament/spatie-laravel-media-library-plugin": "^5.11.1",
    "league/csv": "^9.29.0",
    "openspout/openspout": "^4.32",
    "php": "^8.5",
    "spatie/laravel-pdf": "^2.14"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentAffiliates\\": "src/",
      "AIArmada\\FilamentAffiliates\\Database\\Factories\\": "database/factories/",
      "AIArmada\\FilamentAffiliates\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentAffiliates\\FilamentAffiliatesServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "suggest": {
    "aiarmada/events": "Optional integration",
    "aiarmada/filament-vouchers": "Optional integration",
    "aiarmada/products": "Optional integration",
    "aiarmada/ticketing": "Optional integration",
    "aiarmada/vouchers": "Optional integration"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
