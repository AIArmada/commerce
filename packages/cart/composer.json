{
    "name": "aiarmada/cart",
    "description": "A comprehensive commerce ecosystem for Laravel with cart, payments, vouchers, shipping, and inventory management.",
    "license": "MIT",
    "homepage": "https://github.com/aiarmada/commerce",
    "support": {
        "issues": "https://github.com/aiarmada/commerce/issues",
        "source": "https://github.com/aiarmada/commerce"
    },
    "require": {
        "aiarmada/commerce-support": "self.version",
        "php": "^8.5"
    },
    "suggest": {
        "aiarmada/cart-graphql": "GraphQL API layer with queries, mutations, and subscriptions",
        "aiarmada/signals": "Optional cart analytics and alerting through the Signals package"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Cart\\": "src",
            "AIArmada\\Cart\\Database\\Factories\\": "database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Cart\\CartServiceProvider"
            ],
            "aliases": {
                "Cart": "AIArmada\\Cart\\Facades\\Cart"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
