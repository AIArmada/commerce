{
  "name": "aiarmada/filament-cashier",
  "description": "Unified Filament admin interface for multi-gateway billing management",
  "license": "MIT",
  "keywords": [
    "filament",
    "cashier",
    "billing",
    "subscriptions",
    "stripe",
    "chip",
    "payments",
    "multi-gateway"
  ],
  "homepage": "https://github.com/aiarmada/commerce",
  "authors": [
    {
      "name": "AIArmada",
      "email": "support@aiarmada.com"
    }
  ],
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/cashier": "self.version",
    "filament/filament": "^5.11.1",
    "php": "^8.5"
  },
  "suggest": {
    "aiarmada/cashier-chip": "Required for CHIP gateway features",
    "aiarmada/chip": "Optional integration",
    "aiarmada/filament-cashier-chip": "Enhanced CHIP-specific UI",
    "laravel/cashier": "Required for Stripe gateway features"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentCashier\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentCashier\\FilamentCashierServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "nikic/php-parser": "^5"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
