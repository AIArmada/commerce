{
    "name": "aiarmada/filament-seating",
    "description": "Filament admin for aiarmada/seating: manage seat maps, sections, and occupancy.",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "aiarmada/seating": "self.version",
        "aiarmada/commerce-support": "self.version",
        "aiarmada/filament-commerce-support": "self.version",
        "filament/filament": "^5.11.1"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\FilamentSeating\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\FilamentSeating\\FilamentSeatingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "cd ../.. && php vendor/bin/phpstan analyse -c packages/filament-seating/tools/package-phpstan.neon --autoload-file=packages/filament-seating/tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
