{
  "name": "aiarmada/promotions",
  "description": "Automatic promotions and discount campaigns for commerce",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "AIArmada Team"
    }
  ],
  "require": {
    "php": "^8.5",
    "aiarmada/commerce-support": "self.version",
    "illuminate/database": "^13.40.0",
    "illuminate/support": "^13.40.0",
    "spatie/laravel-activitylog": "^5.1.3",
    "spatie/laravel-data": "^4.23.1",
    "spatie/laravel-package-tools": "^1.93.3"
  },
  "suggest": {
    "aiarmada/cart": "Optional integration",
    "aiarmada/orders": "Optional integration",
    "aiarmada/products": "For product/category targeting in promotions",
    "aiarmada/vouchers": "Optional integration"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\Promotions\\": "src/",
      "AIArmada\\Promotions\\Database\\Factories\\": "database/factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\Promotions\\PromotionsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "nikic/php-parser": "^5"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
