{
  "name": "aiarmada/organizations",
  "description": "Reusable organization tenancy aggregate, membership ownership, and lifecycle workflows.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "organizations",
    "tenancy",
    "multitenancy",
    "membership"
  ],
  "authors": [
    {
      "name": "AIArmada",
      "email": "dev@aiarmada.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "aiarmada/commerce-support": "self.version",
    "aiarmada/membership": "self.version",
    "spatie/laravel-package-tools": "^1.93.3"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\Organizations\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\Organizations\\OrganizationsServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
