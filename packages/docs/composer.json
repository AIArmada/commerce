{
    "name": "aiarmada/docs",
    "description": "Doc generation package for Laravel with PDF support for invoices, receipts, shipping labels, and customizable templates",
    "license": "MIT",
    "homepage": "https://github.com/aiarmada/commerce",
    "support": {
        "issues": "https://github.com/aiarmada/commerce/issues",
        "source": "https://github.com/aiarmada/commerce"
    },
    "require": {
        "aiarmada/commerce-support": "self.version",
        "spatie/browsershot": "^5.4.2",
        "spatie/laravel-pdf": "^2.14.0",
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Docs\\": "src/",
            "AIArmada\\Docs\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Docs\\DocsServiceProvider"
            ],
            "aliases": {
                "Doc": "AIArmada\\Docs\\Facades\\Doc"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
