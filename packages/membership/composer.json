{
    "name": "aiarmada/membership",
    "description": "Multi-tenant membership management: applications, invitations, and member roles for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "aiarmada/authz": "self.version",
        "aiarmada/commerce-support": "self.version",
        "lorisleiva/laravel-actions": "^2.13.0",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Membership\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Membership\\MembershipServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
