{
  "name": "aiarmada/orders",
  "description": "Order management and transaction lifecycle for the AIArmada Commerce ecosystem",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "laravel",
    "commerce",
    "orders",
    "transactions",
    "state-machine",
    "invoices"
  ],
  "authors": [
    {
      "name": "AIArmada",
      "email": "dev@aiarmada.com"
    }
  ],
  "require": {
    "aiarmada/addressing": "self.version",
    "aiarmada/commerce-support": "self.version",
    "spatie/browsershot": "^5.4.2",
    "spatie/laravel-pdf": "^2.14.0",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\Orders\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\Orders\\OrdersServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "suggest": {
    "aiarmada/docs": "Optional integration",
    "aiarmada/inventory": "Optional integration",
    "aiarmada/shipping": "Optional integration"
  },
  "require-dev": {
    "nikic/php-parser": "^5"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
