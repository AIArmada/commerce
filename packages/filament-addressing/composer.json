{
    "name": "aiarmada/filament-addressing",
    "description": "Filament v5 adapter for aiarmada/addressing.",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "aiarmada/addressing": "self.version",
        "aiarmada/commerce-support": "self.version",
        "filament/filament": "^5.11.1",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\FilamentAddressing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AIArmada\\FilamentAddressing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\FilamentAddressing\\FilamentAddressingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
