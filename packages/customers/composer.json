{
    "name": "aiarmada/customers",
    "description": "Customer relationship management for the AIArmada Commerce ecosystem",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "commerce",
        "customers",
        "crm",
        "addresses",
        "segments"
    ],
    "authors": [
        {
            "name": "AIArmada",
            "email": "dev@aiarmada.com"
        }
    ],
    "require": {
        "aiarmada/addressing": "self.version",
        "aiarmada/contacting": "self.version",
        "aiarmada/commerce-support": "self.version",
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Customers\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Customers\\CustomersServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
