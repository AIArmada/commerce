{
  "name": "aiarmada/filament-links",
  "description": "Filament admin adapter for the AIArmada links package - link management, click history, and lifecycle actions",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "laravel",
    "filament",
    "links",
    "redirect",
    "click-tracking"
  ],
  "authors": [
    {
      "name": "AIArmada",
      "email": "dev@aiarmada.com"
    }
  ],
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/links": "self.version",
    "filament/filament": "^5.11.1",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentLinks\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentLinks\\FilamentLinksServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "nikic/php-parser": "^5"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
