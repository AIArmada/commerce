{
    "name": "aiarmada/persons",
    "description": "Reusable person identity package for Laravel - normalized persons, multi-context names, titles, credentials, and affiliations with polymorphic assignment tables",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "persons",
        "identity",
        "titles",
        "credentials",
        "affiliations"
    ],
    "authors": [
        {
            "name": "AIArmada",
            "email": "dev@aiarmada.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-data": "^4.23.1",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "suggest": {
        "aiarmada/addressing": "Optional integration for nationality, title country scoping, and issuer country resolution.",
        "spatie/laravel-medialibrary": "Required for media collections on the Person model."
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Persons\\": "src/",
            "AIArmada\\Persons\\Database\\Factories\\": "database/factories",
            "AIArmada\\Persons\\Database\\Seeders\\": "database/seeders"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Persons\\PersonsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
