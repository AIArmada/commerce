parameters:
    customRulesetUsed: true
    configDirectories:
        - ../config
    paths:
        - ../src
        - ../config
    tmpDir: ../../../build/phpstan-arch-affiliates

expandRelativePaths:
    - '[parameters][configDirectories][]'

services:
    -
        class: PackageArchitecture\StaticAnalysis\PackageOwnedWriteRule
        arguments:
            projectRoot: null
        tags:
            - phpstan.rules.rule
