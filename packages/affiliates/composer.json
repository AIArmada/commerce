{
  "name": "aiarmada/affiliates",
  "description": "Affiliate attribution, referral tracking, and commission management for Laravel commerce stacks.",
  "license": "MIT",
  "homepage": "https://github.com/aiarmada/commerce",
  "support": {
    "issues": "https://github.com/aiarmada/commerce/issues",
    "source": "https://github.com/aiarmada/commerce"
  },
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/contacting": "self.version",
    "php": "^8.5",
    "spatie/browsershot": "^5.4.2",
    "spatie/laravel-medialibrary": "^11.23.11",
    "spatie/laravel-pdf": "^2.14.0",
    "spatie/laravel-settings": "^3.10.1"
  },
  "suggest": {
    "aiarmada/links": "Creates permanent short and branded affiliate campaign links.",
    "aiarmada/affiliate-network": "Binds the network seam adapters (identity, ledger, programs, local catalog).",
    "aiarmada/cart": "Enables cart level attribution helpers and conversion tracking",
    "aiarmada/orders": "Optional integration",
    "aiarmada/vouchers": "Auto associates affiliate codes with voucher campaigns"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\Affiliates\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\Affiliates\\AffiliatesServiceProvider"
      ],
      "aliases": {
        "Affiliate": "AIArmada\\Affiliates\\Facades\\Affiliate"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
