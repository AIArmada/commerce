{
    "name": "aiarmada/links",
    "description": "Generic tracked-link management for Laravel - cloaked redirects, click capture, expiry and limits, with domain events for third-party integrations",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aiarmada/commerce-support": "self.version",
        "lorisleiva/laravel-actions": "^2.12.0",
        "matomo/device-detector": "^6.5.1",
        "spatie/laravel-package-tools": "^1.93.2"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Links\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Links\\LinksServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
