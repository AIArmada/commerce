{
  "name": "aiarmada/filament-orders",
  "description": "Filament admin panel for order management",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "laravel",
    "filament",
    "orders",
    "admin",
    "commerce"
  ],
  "authors": [
    {
      "name": "AIArmada",
      "email": "dev@aiarmada.com"
    }
  ],
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/orders": "self.version",
    "filament/filament": "^5.11.1",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentOrders\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentOrders\\FilamentOrdersServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "suggest": {
    "aiarmada/jnt": "Optional integration"
  },
  "require-dev": {
    "nikic/php-parser": "^5"
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
