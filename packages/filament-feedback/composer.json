{
    "name": "aiarmada/filament-feedback",
    "description": "Filament v5 admin adapter for aiarmada/feedback.",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "aiarmada/feedback": "self.version",
        "filament/filament": "^5.11.1"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\FilamentFeedback\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\FilamentFeedback\\FilamentFeedbackServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    },
    "require-dev": {
        "nikic/php-parser": "^5"
    }
}
