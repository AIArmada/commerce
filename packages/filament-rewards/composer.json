{
  "name": "aiarmada/filament-rewards",
  "description": "A Filament v5 plugin for administering reward programs provided by the AIArmada rewards package",
  "license": "MIT",
  "homepage": "https://github.com/AIArmada/filament-rewards",
  "support": {
    "issues": "https://github.com/AIArmada/filament-rewards/issues",
    "source": "https://github.com/AIArmada/filament-rewards"
  },
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/rewards": "self.version",
    "filament/filament": "^5.8.1",
    "php": "^8.5"
  },
  "suggest": {
    "aiarmada/affiliates": "Enables the fraud-signal resource",
    "aiarmada/filament-vouchers": "Enables deep linking from coupon benefits to vouchers"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentRewards\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentRewards\\FilamentRewardsServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
